# Browser-visible Turnstile site key. Use Cloudflare's test key locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Turnstile secret and exact accepted production hostnames.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=saladovillageframer.com,www.saladovillageframer.com

# One Upstash Redis database provides the durable audit, locks, rate limits,
# and retry set. It is attached to this existing Vercel project.
INTAKE_REDIS_REST_URL=
INTAKE_REDIS_REST_TOKEN=
INTAKE_HASH_SECRET=

# Nimble access and pre-verified immutable IDs.
NIMBLE_ACCESS_TOKEN=
NIMBLE_CHERIE_OWNER_ID=
NIMBLE_SOLAS_PIPELINE_ID=
NIMBLE_NEW_INQUIRY_STAGE_ID=
NIMBLE_TASK_ENDPOINT=https://app.nimble.com/api/v1/tasks

# Existing Brevo account. The default sender stays on the already-authenticated
# Solas domain; this canary does not require a DNS change.
BREVO_API_KEY=
BREVO_SVF_SENDER_EMAIL=cherie@solasgallery.com
BREVO_SVF_SENDER_NAME=Salado Village Framer
INTAKE_NOTIFICATION_EMAIL=cherie@solasgallery.com

# Protects the manual/scheduled retry endpoint.
CRON_SECRET=

# Optional comma-separated additions to the built-in disposable-domain list.
DISPOSABLE_EMAIL_DOMAINS=
